# 强制 LF 换行符,避免 Windows CRLF 污染 Docker 构建
* text=auto eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.dockerignore text eol=lf
*.gitignore text eol=lf
