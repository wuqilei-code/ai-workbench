# docker-compose 凭据模板:复制为 .env 后填入真实值
# cp .env.example .env
#
# 生成 AES 密钥(32字节 Base64): openssl rand -base64 32
# 生成 JWT 密钥:                openssl rand -hex 32
# 生成 MySQL 密码:              openssl rand -hex 16

OPENCODE_SERVER_PASSWORD=please-change-me
JWT_SECRET=please-generate-a-32+-char-random-secret
APP_AES_KEY=please-generate-base64-32byte-key
SPRING_DATASOURCE_PASSWORD=please-change-me
MYSQL_ROOT_PASSWORD=please-change-me
MYSQL_PASSWORD=please-change-me
