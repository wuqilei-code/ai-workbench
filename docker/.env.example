# docker-compose 环境变量模板:复制为 .env 后填入真实值
#   cp .env.example .env
#
# 生成密钥的参考命令:
#   JWT_SECRET:   openssl rand -hex 32
#   APP_AES_KEY:  openssl rand -base64 32
#   INTERNAL_TOKEN: openssl rand -hex 32
#   密码:         openssl rand -hex 16
#
# 带「必填」的变量 compose 启动时缺失会直接报错,不要留空。

# ── 应用网关(app:8080→80) ─────────────────────────────────────
APP_REGISTRATION_ENABLED=true             # 是否开放注册(默认开,方便建号;公网部署建议改 false 防批量滥用)
APP_QUOTA_DAILY_TOKENS=0                   # 每用户每日 token 配额(0=不限);超限发送消息 429
WORKSPACE_ROOT=/workspace                 # 用户工作区卷内根(与 compose 卷对应,一般不用改)
WORKSPACE_PER_USER_DATA_ROOT=/data/users  # 用户数据(技能/上传)根(一般不用改)
WORKSPACE_UID_BASE=100000                 # 每用户 uid 隔离起点(一般不用改)

# ── 必填:密钥 / 密码 ───────────────────────────────────────────
# 务必替换为随机值;JWT_SECRET 必须 ≥ 32 字节,否则应用启动即失败。
JWT_SECRET=please-generate-32+hex-chars   # 必填:登录态签名密钥(≥32 字节)
APP_AES_KEY=please-generate-base64-32byte # 必填:AES 加密密钥(Base64 编码 32 字节)
INTERNAL_TOKEN=please-generate-random-64  # 必填:网关↔agent-service 内部回调共享令牌(两边一致)
SPRING_DATASOURCE_PASSWORD=please-change-me  # 必填:MySQL aiworkbench 用户密码(与 MYSQL_PASSWORD 一致)
MYSQL_ROOT_PASSWORD=please-change-me        # 必填:MySQL root 密码
MYSQL_PASSWORD=please-change-me             # 必填:MySQL aiworkbench 用户密码

# ── 默认模型(agent-service 执行后端;可选) ────────────────────
# 推荐在「管理 → 模型配置」页添加 provider/model(带常用厂商预设),这里作为**回退**:
# 仅当系统未配置任何启用的 provider 时,agent 才使用下列默认模型。
AGENT_MODEL=deepseek-chat                  # 回退模型名(未配置 provider 时使用)
AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL_API_KEY=sk-...                 # 回退模型 API Key(勿提交 git)
AGENT_HITL=true                            # HITL:write/edit/delete/execute 需人工确认
AGENT_SERVICE_PORT=8000                    # 仅绑回环,宿主端口(调试用)

# ── deepagents 持久化(postgres) ────────────────────────────────
POSTGRES_PASSWORD=please-change-me         # postgres 密码(agent 线程 checkpoint/store)

# ── 执行沙箱(AIO Sandbox;execute/文件/浏览器运行处,自带 VNC/VSCode) ──
# 需自行拉取并打 tag(约 13GB),否则沙箱类工具不可用:
#   docker pull ghcr.io/agent-infra/sandbox:1.11.0
#   docker tag  ghcr.io/agent-infra/sandbox:1.11.0 aio-sandbox:latest
# 国内镜像:enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:1.11.0
AGENT_SANDBOX_BACKEND=aio
AGENT_SANDBOX_IMAGE=aio-sandbox:latest
AGENT_SANDBOX_NETWORK=true
AGENT_SANDBOX_NETWORK_NAME=aiwb-agents
# daemon 视角的用户数据根:卷名 = <项目名>_workspace(本项目名固定为 ai-workbench)
AGENT_SANDBOX_VOLUME_ROOT=/var/lib/docker/volumes/ai-workbench_workspace/_data/users
AGENT_SANDBOX_UID=1000
AGENT_SANDBOX_MEM_MB=4096
AGENT_SANDBOX_CPUS=2.0
AGENT_SANDBOX_PIDS=512
AGENT_SANDBOX_IDLE_TTL=1800
AGENT_SANDBOX_MAX_TIMEOUT=120
AGENT_SANDBOX_MAX_ACTIVE=0                    # 并发沙箱上限(0=不限);超过后拒绝新建,防资源耗尽

# ── 并发 / 调度(一般用默认) ────────────────────────────────────
AGENT_JOBS_MAX_CONCURRENT=1
AGENT_JOBS_TIMEOUT_MINUTES=30
AGENT_JOBS_MAX_RETRIES=2                   # 任务失败自动重试次数
AGENT_JOBS_WEBHOOK_URL=                    # 任务最终失败时告警 Webhook(可选,POST JSON)
AGENT_JOBS_PAUSED=false                    # 定时任务全局暂停初值(运行时可经管理员接口切换)
AGENT_WORKERS=4
AGENT_MAX_TURNS=10000                      # 单请求步数上限(上下文由自动压缩管理)
AGENT_PG_POOL_MIN=2
AGENT_PG_POOL_MAX=10

# ── 安全加固(可选;不填即默认) ─────────────────────────────────
INTERNAL_TRUSTED_CIDRS=                    # /api/internal/** 与 agent-service 的来源白名单(IPv4/CIDR;空=仅校验令牌)
AGENT_OUTBOUND_ALLOWLIST=                  # 出站 SSRF 白名单主机(逗号分隔)
AGENT_ALLOW_PRIVATE_OUTBOUND=false         # 是否允许出站访问内网(内网私有部署可设 true)
OPENAPI_ENABLED=true                       # 是否开启 /v3/api-docs 与 Swagger UI(生产可设 false)

# ── 数据源 / 跨副本(可选) ──────────────────────────────────────
MYSQL_HOST=mysql                           # 默认连 compose 自带 mysql 容器;用外部 MySQL 时改为其主机名(如 host.docker.internal)
SSE_RELAY_ENABLED=true                     # 会话事件跨副本中继(基于 session_event 出站表)
SSE_RELAY_POLL_MS=500                      # 中继轮询间隔

# ── 镜像仓库加速(可选) ─────────────────────────────────────────
# DOCKER_REGISTRY=docker.m.daocloud.io
